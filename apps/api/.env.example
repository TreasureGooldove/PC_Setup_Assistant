APP_ENV=development
DATABASE_URL=sqlite:///./data/assistant.db
LLM_ENABLED=false
LLM_API_KEY=
LLM_API_BASE=https://example.invalid/compatible-mode/v1
LLM_MODEL=qwen3.8-max
STEAM_API_ENABLED=false
STEAM_API_BASE=https://store.steampowered.com/api
# 固定白名单公开产品目录：默认后台同步，失败时保留 Fixture 与最近缓存。
CATALOG_PUBLIC_SYNC_ENABLED=true
CATALOG_SYNC_TTL_HOURS=12
CATALOG_SYNC_MAX_ITEMS=40
CATALOG_SYNC_TIMEOUT_SECONDS=8
CATALOG_SYNC_MAX_RESPONSE_BYTES=1000000
# 可选：只解析显式配置的京东公开商品页，不使用登录态或反爬绕过。
JD_PUBLIC_FETCH_ENABLED=false
JD_PRODUCT_URLS_JSON={}
# 报价源凭证仅放在本机未跟踪的 .env；缺任一字段时平台保持停用。
JD_APP_KEY=
JD_APP_SECRET=
JD_PID=
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=
CORS_ORIGINS=http://localhost:5173
JOB_LEASE_SECONDS=60
JOB_POLL_SECONDS=0.5
